{"abi":[{"inputs":[{"internalType":"address","name":"_factory","type":"address"},{"internalType":"address","name":"_WETH","type":"address"}],"stateMutability":"nonpayable","type":"constructor"},{"inputs":[],"name":"WETH","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"factory","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"tokenA","type":"address"},{"internalType":"address","name":"tokenB","type":"address"}],"name":"pairFor","outputs":[{"internalType":"address","name":"pair","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"amountA","type":"uint256"},{"internalType":"uint256","name":"reserveA","type":"uint256"},{"internalType":"uint256","name":"reserveB","type":"uint256"}],"name":"quote","outputs":[{"internalType":"uint256","name":"amountB","type":"uint256"}],"stateMutability":"view","type":"function"}],"compilation":{"language":"Solidity","compiler":"solc","compilerVersion":"0.6.6+commit.6c089d02","compilerSettings":{"metadata":{"bytecodeHash":"ipfs"},"libraries":{},"optimizer":{"runs":999999,"enabled":true},"evmVersion":"istanbul","remappings":[]},"name":"UniswapV2Router02","fullyQualifiedName":"UniswapV2Router02.sol:UniswapV2Router02"},"stdJsonInput":{"language":"Solidity","sources":{"UniswapV2Router02.sol":{"content":"// SPDX-License-Identifier: MIT\npragma solidity =0.6.6;\n\ncontract UniswapV2Router02 {\n    address public immutable factory;\n    address public immutable WETH;\n\n    bytes32 internal constant INIT_CODE_PAIR_HASH =\n        hex'96e8ac4277198ff8b6f785478aa9a39f403cb768dd02cbee326c3e7da348845f';\n\n    constructor(address _factory, address _WETH) public {\n        factory = _factory;\n        WETH = _WETH;\n    }\n\n    function pairFor(address tokenA, address tokenB) public view returns (address pair) {\n        (address token0, address token1) = tokenA < tokenB ? (tokenA, tokenB) : (tokenB, tokenA);\n        pair = address(uint(keccak256(abi.encodePacked(\n            hex'ff',\n            factory,\n            keccak256(abi.encodePacked(token0, token1)),\n            INIT_CODE_PAIR_HASH\n        ))));\n    }\n\n    function quote(uint amountA, uint reserveA, uint reserveB) public view returns (uint amountB) {\n        require(amountA > 0 && reserveA > 0 && WETH != address(0), \"Router: INVALID\");\n        amountB = (amountA * reserveB) / reserveA;\n    }\n}\n"}},"settings":{"metadata":{"bytecodeHash":"ipfs"},"libraries":{},"optimizer":{"runs":999999,"enabled":true},"evmVersion":"istanbul","remappings":[]}},"creationBytecode":{"transformationValues":{"constructorArguments":"0x0000000000000000000000005c69bee701ef814a2b6a3edd4b1652cb9cc5aa6f000000000000000000000000c02aaa39b223fe8d0a0e5c4f27ead9083c756cc2"},"linkReferences":{}},"runtimeBytecode":{"immutableReferences":{"3":[{"length":32,"start":447},{"length":32,"start":815}],"5":[{"length":32,"start":570},{"length":32,"start":630}]},"linkReferences":{}},"deployment":{"transactionHash":"0x1e8f53f4b2b5cf17500b5a4d09b3e9f9d60df6e4e7f7c9d1b642c2f1f133b2a1","blockNumber":"10207858","transactionIndex":"48","deployer":"0x9C39859e0F4d3D564b0F1fF5d74bF2B21b9d9B2d"},"proxyResolution":{"isProxy":false,"proxyType":null,"implementations":[]},"matchId":"1000002","creationMatch":"exact_match","runtimeMatch":"exact_match","verifiedAt":"2026-01-01T00:00:00Z","match":"exact_match","chainId":"1","address":"0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D"}