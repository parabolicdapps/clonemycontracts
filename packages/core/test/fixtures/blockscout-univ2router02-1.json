"proxy_type":null,"implementations":[],"verified_at":"2026-01-01T00:00:00.000000Z","is_verified_via_verifier_alliance":false,"compiler_version":"v0.6.6+commit.6c089d02","decoded_constructor_args":[["0x5C69bEe701ef814a2B6a3EDD4B1652CB9cc5aA6f",{"name":"_factory","type":"address"}],["0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2",{"name":"_WETH","type":"address"}]],"sourcify_repo_url":null,"optimization_runs":999999,"compiler_settings":{"libraries":{},"optimizer":{"enabled":true,"runs":999999},"outputSelection":{"*":{"*":["abi","evm.bytecode","evm.deployedBytecode"]}}},"is_verified":true,"verified_twin_address_hash":null,"optimization_enabled":true,"deployed_bytecode":"","source_code":"// SPDX-License-Identifier: MIT\npragma solidity =0.6.6;\n\nimport \"./interfaces/IRouterHelper.sol\";\n\ncontract UniswapV2Router02 is IRouterHelper {\n    address public immutable factory;\n    address public immutable WETH;\n\n    bytes32 internal constant INIT_CODE_PAIR_HASH =\n        hex'96e8ac4277198ff8b6f785478aa9a39f403cb768dd02cbee326c3e7da348845f';\n\n    constructor(address _factory, address _WETH) public {\n        factory = _factory;\n        WETH = _WETH;\n    }\n\n    function pairFor(address tokenA, address tokenB) external view override returns (address pair) {\n        (address token0, address token1) = tokenA < tokenB ? (tokenA, tokenB) : (tokenB, tokenA);\n        pair = address(uint(keccak256(abi.encodePacked(\n            hex'ff',\n            factory,\n            keccak256(abi.encodePacked(token0, token1)),\n            INIT_CODE_PAIR_HASH\n        ))));\n    }\n\n    function quote(uint amountA, uint reserveA, uint reserveB) external view override returns (uint amountB) {\n        require(amountA > 0 && reserveA > 0 && WETH != address(0), \"Router: INVALID\");\n        amountB = (amountA * reserveB) / reserveA;\n    }\n}\n","creation_status":"success","file_path":"contracts/UniswapV2Router02.sol"}